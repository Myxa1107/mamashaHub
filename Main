if game.PlaceId ~= 103037106396302 then
	game.Players.LocalPlayer:Kick([[Unsupported game!
	Supported PlaceID: 103037106396302
	This game PlaceID:]] .. game.PlaceId .. [[
	Supported Place: TROLL Hug Tower]])
end

local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local run = RunService
local UserInputService = game:GetService("UserInputService")
local uis = UserInputService
local LocalPlayer = Players.LocalPlayer
local lp = LocalPlayer
local camera = workspace.CurrentCamera
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HugTarget = nil
local GrabEvent = game:GetService("ReplicatedStorage").HugRemotes.HugRequest
local isKilling = false

-- Logics

-- Fly
local FlyActive = false
local FlySpeed = 50
local FlyBindEnabledState

local bv = Instance.new("BodyVelocity")
local bg = Instance.new("BodyGyro")

local function togglefly()
	local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end

	if FlyActive then
		bv.Parent = root
		bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		bv.Velocity = Vector3.new(0, 0, 0)

		bg.Parent = root
		bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		bg.CFrame = root.CFrame
	else
		bv.Parent = nil
		bg.Parent = nil
		if lp.Character:FindFirstChildOfClass("Humanoid") then
			lp.Character.Humanoid.PlatformStand = false
		end
	end
end

run.RenderStepped:Connect(function()
	local char = lp.Character
	if FlyActive and char and char:FindFirstChild("HumanoidRootPart") then
		local root = char.HumanoidRootPart
		local cam = workspace.CurrentCamera
		local dir = Vector3.new(0, 0, 0)

		if uis:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
		if uis:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
		if uis:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
		if uis:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end

		bv.Velocity = dir * FlySpeed
		bg.CFrame = cam.CFrame
		char.Humanoid.PlatformStand = true
	end
end)

-- AntiGrab
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- НАСТРОЙКИ ДВИЖЕНИЯ
local WALK_SPEED = 16 
local JUMP_POWER = 35 
local GRAVITY = 100   

local isJumping = false
local verticalVelocity = 0
local forceTpWalk = false 
local antiVelocityTimer = 0 
local throwSafetyTimer = 0 

-- 1. СЕТЕВОЙ ПЕРЕХВАТ ПАКЕТА COBALT
local HugState = ReplicatedStorage:WaitForChild("HugRemotes", 5):WaitForChild("HugState", 5)
if HugState and getconnections then
	for _, connection in ipairs(getconnections(HugState.OnClientEvent)) do
		local oldFunction = connection.Function
		connection:Disable() 

		HugState.OnClientEvent:Connect(function(action, targetCharacter, ...)
			if _G.antigrabenabled then
				local myChar = LocalPlayer.Character

				if myChar and targetCharacter == myChar then
					if action == "grabEffects" or action == "started" or action == "targetStarted" then
						forceTpWalk = true 
						antiVelocityTimer = 0.3
						throwSafetyTimer = 0
					elseif action == "throwEffects" then
						forceTpWalk = true
						antiVelocityTimer = 0.5
						throwSafetyTimer = 0.5 
					elseif action == "hugEnded" or action == "ended" or action == "targetEnded" then
						forceTpWalk = false 
						isJumping = false
						throwSafetyTimer = 0
					end
				end
			end

			pcall(oldFunction, action, targetCharacter, ...)
		end)
	end
end

-- Основной цикл физики
if _G.HugHeartbeatConnection then _G.HugHeartbeatConnection:Disconnect() end
_G.HugHeartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
	if not _G.antigrabenabled then 
		forceTpWalk = false
		antiVelocityTimer = 0
		throwSafetyTimer = 0
		return 
	end

	local character = LocalPlayer.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera

	local foundWeld = false

	-- Уничтожаем велды хага
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("Weld") or part:IsA("WeldConstraint") or part:IsA("ManualWeld") or part:IsA("SeatWeld") then
			if part.Name:match("Hug") or part.Name == "HugRootWeld" or part:IsA("SeatWeld") then
				part:Destroy()
				foundWeld = true
				antiVelocityTimer = 0.3
			end
		elseif part:IsA("AlignPosition") and part.Name:match("Hug") then
			part:Destroy()
			foundWeld = true
			antiVelocityTimer = 0.3
		end
	end

	if foundWeld then
		forceTpWalk = true
		throwSafetyTimer = 0 
	end

	if antiVelocityTimer > 0 then
		antiVelocityTimer = antiVelocityTimer - deltaTime
	end

	if throwSafetyTimer > 0 then
		throwSafetyTimer = throwSafetyTimer - deltaTime
		if throwSafetyTimer <= 0 and not foundWeld then
			forceTpWalk = false 
		end
	end

	-- ЖЕСТКОЕ ГАШЕНИЕ СКОРОСТИ ОТ БРОСКА
	if (forceTpWalk or antiVelocityTimer > 0) and rootPart then
		rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		for _, obj in ipairs(rootPart:GetChildren()) do
			if obj:IsA("BodyMover") or obj:IsA("Force") or obj:IsA("VectorForce") or obj:IsA("LineForce") then
				obj:Destroy()
			end
		end
	end

	if humanoid and forceTpWalk then
		humanoid.Sit = false
		humanoid.PlatformStand = false
	end

	-- 2. СТАБИЛЬНЫЙ TPWALK С ПРОВЕРКОЙ СТЕН
	if forceTpWalk and rootPart and camera then
		local moveDirection = Vector3.new(0, 0, 0)

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then
			moveDirection = moveDirection + camera.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then
			moveDirection = moveDirection - camera.CFrame.LookVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then
			moveDirection = moveDirection - camera.CFrame.RightVector
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then
			moveDirection = moveDirection + camera.CFrame.RightVector
		end

		moveDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)

		if moveDirection.Magnitude > 0 then
			local dtMove = moveDirection.Unit * (WALK_SPEED * deltaTime)

			-- ИСПРАВЛЕНО: Проверяем наличие стены в направлении нашего шага
			local wallParams = RaycastParams.new()
			wallParams.FilterType = Enum.RaycastFilterType.Exclude
			wallParams.FilterDescendantsInstances = {character}

			-- Пускаем луч из центра торса вперед на 2 ступни
			local wallCheck = workspace:Raycast(rootPart.Position, moveDirection.Unit * 2, wallParams)

			-- Если стены впереди нет — только тогда делаем шаг CFrame
			if not wallCheck then
				rootPart.CFrame = rootPart.CFrame + dtMove
			end
		end

		-- 3. СИМУЛЯЦИЯ ПРЫЖКА
		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = {character}
		local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -3.5, 0), raycastParams)

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) and not isJumping and rayResult and not UserInputService:GetFocusedTextBox() then
			isJumping = true
			verticalVelocity = JUMP_POWER
		end

		if isJumping then
			rootPart.CFrame = rootPart.CFrame + Vector3.new(0, verticalVelocity * deltaTime, 0)
			verticalVelocity = verticalVelocity - (GRAVITY * deltaTime)

			if verticalVelocity <= 0 and rayResult then
				isJumping = false
				verticalVelocity = 0
				rootPart.CFrame = CFrame.new(rootPart.Position.X, rayResult.Position.Y + 3.4, rootPart.Position.Z) * CFrame.Angles(0, math.rad(rootPart.Orientation.Y), 0)
			end
		else
			if not rayResult then
				isJumping = true
				verticalVelocity = 0 
			end
		end
	end
end)

-- ESP

-- НАСТРОЙКИ
local ESPENABLED = false -- Теперь изначально ВЫКЛЮЧЕНО
local FONT = Enum.Font.Gotham
local TEXT_SIZE = 14
local NEUTRAL = Color3.fromRGB(255, 255, 255)
local floor = math.floor
local UPDATE_EVERY = 4

local esp = {}
local connections = {}

local function teamColor(p)
	local team = p.Team
	if team then
		local tc = team.TeamColor
		if tc then
			return tc.Color
		end
	end
	return NEUTRAL
end

local function cleanup(p)
	local d = esp[p]
	if d then
		if d.gui1 then d.gui1:Destroy() end
		if d.gui2 then d.gui2:Destroy() end
		if d.hl  then d.hl:Destroy()  end
		esp[p] = nil
	end
end

local function applyColor(p, d)
	local c = teamColor(p)
	d.nLabel.TextColor3 = c
	d.hl.OutlineColor = c
end

local function onChar(p, char)
	cleanup(p)
	if not ESPENABLED then return end

	local root = char:WaitForChild("HumanoidRootPart", 5)
	if not root or not root.Parent or not char.Parent then return end

	-- name (above head)
	local gui1 = Instance.new("BillboardGui")
	gui1.Name = "NameESP"
	gui1.AlwaysOnTop = true
	gui1.Size = UDim2.fromOffset(90, 12)
	gui1.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	gui1.Adornee = root
	gui1.Parent = root

	local nLabel = Instance.new("TextLabel")
	nLabel.BackgroundTransparency = 1
	nLabel.Size = UDim2.fromScale(1, 1)
	nLabel.Font = FONT
	nLabel.TextSize = TEXT_SIZE
	nLabel.TextColor3 = Color3.new(1, 1, 1)
	nLabel.TextStrokeTransparency = 1
	nLabel.Text = p.Name
	nLabel.Parent = gui1

	-- highlight
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 1
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Adornee = char
	hl.Parent = char

	esp[p] = {
		root     = root,
		nLabel   = nLabel,
		dLabel   = dLabel,
		hl       = hl,
		gui1     = gui1,
		lastTeam = p.Team,
	}
	applyColor(p, esp[p])
end

local function attach(p)
	if p == LocalPlayer then return end

	if connections[p] then
		connections[p]:Disconnect()
	end

	if p.Character and ESPENABLED then
		task.spawn(onChar, p, p.Character)
	end

	connections[p] = p.CharacterAdded:Connect(function(char)
		onChar(p, char)
	end)
end

Players.PlayerAdded:Connect(attach)
for _, p in Players:GetPlayers() do attach(p) end

Players.PlayerRemoving:Connect(function(p)
	cleanup(p)
	if connections[p] then
		connections[p]:Disconnect()
		connections[p] = nil
	end
end)

local frame = 0
local lastState = ESPENABLED

RunService.Heartbeat:Connect(function()
	-- Отслеживаем глобальное изменение переключателя (включение/выключение)
	if ESPENABLED ~= lastState then
		lastState = ESPENABLED
		if not ESPENABLED then
			for p in esp do cleanup(p) end
		end
	end

	-- Если ESP выключен, ничего не делаем
	if not ESPENABLED then return end

	frame += 1
	if frame % UPDATE_EVERY ~= 0 then return end

	-- Каждое обновление принудительно пересоздаем ESP для живых игроков
	for _, p in Players:GetPlayers() do
		if p ~= LocalPlayer and p.Character then
			-- Вызываем onChar: она сама удалит старый ESP и создаст новый с актуальными данными
			task.spawn(onChar, p, p.Character)
		else
			cleanup(p)
		end
	end
end)

