local function getPlayerNames()
	local names = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(names, player.Name)
		end
	end
	if #names == 0 then
		table.insert(names, "Nothing, mamasha is angry")
	end
	return names
end

Hug:Space({ Columns = 1 })

local PlayerSelectDropdown = Hug:Dropdown({
	Title = "Select Target",
	Options = getPlayerNames(), 
	Current = nil, 
	Callback = function(selectedPlayer)
		HugTarget = Players:FindFirstChild(selectedPlayer)
		print(HugTarget)
	end
})

Hug:Space({ Columns = 1 })

local function updateDropdown()
	local currentPlayers = getPlayerNames()
	PlayerSelectDropdown:Refresh(currentPlayers)
end

Players.PlayerAdded:Connect(function(player)
	task.wait(0.5)
	updateDropdown()
end)

Players.PlayerRemoving:Connect(function(player)
	updateDropdown()
end)

task.spawn(function()
	task.wait(0.2)
	updateDropdown()
end)

local GrabButton = Hug:Button({
	Title = "Grab Target",
	Callback = function()
		if HugTarget ~= nil then
			local ops = LocalPlayer.Character:GetPivot()

			local stats = game:GetService("Stats")
			local function getPingSeconds()
				local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
				return pingMS / 1000
			end
			local currentPing = getPingSeconds()
			local pingDelay = math.max(currentPing * 3, 0.05) -- Защита от нулевого пинга при старте

			local humanoidRootPart = LocalPlayer.Character:WaitForChild("HumanoidRootPart")

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			LocalPlayer.Character:PivotTo(HugTarget.Character:GetPivot())

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			task.wait(pingDelay)

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			GrabEvent:FireServer(
				"tryGrab",
				HugTarget.Character
			)

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			LocalPlayer.Character:PivotTo(ops)

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		end
	end
})

function KillAll()
	local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)

		-- Принудительно возвращаем персонажа в состояние бега/ходьбы
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	local stats = game:GetService("Stats")
	local function getPingSeconds()
		local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		return pingMS / 1000
	end
	local currentPing = getPingSeconds()
	local pingDelay = math.max(currentPing * 3, 0.05) -- Защита от нулевого пинга при старте

	local allplayers = getPlayerNames()
	local ops = LocalPlayer.Character:GetPivot()
	LocalPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = false
	local ows = LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed
	LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
	local targetCFrame = CFrame.new(-149, -51, 152) * CFrame.Angles(math.rad(0), math.rad(-90), math.rad(0))
	local fixplate = Instance.new("Part", workspace)
	fixplate.Anchored = true
	fixplate.Transparency = 1
	fixplate.Size = Vector3.new(100,1,100)
	fixplate.CFrame = targetCFrame - Vector3.new(0,4,0)
	for _,v in allplayers do
		local killplr = Players:FindFirstChild(v)
		isKilling = true

		local humanoidRootPart = LocalPlayer.Character:WaitForChild("HumanoidRootPart")

		LocalPlayer.Character:PivotTo(killplr.Character:GetPivot())

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		task.wait(pingDelay)

		GrabEvent:FireServer(
			"tryGrab",
			killplr.Character
		)

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		LocalPlayer.Character:PivotTo(targetCFrame)

		task.wait(pingDelay)
		GrabEvent:FireServer(
			"throw"
		)

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		task.wait(1)
	end
	LocalPlayer.Character:PivotTo(ops)
	LocalPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = true
	fixplate:Destroy()
	LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = ows
	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)

		-- Принудительно возвращаем персонажа в состояние бега/ходьбы
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	task.wait(0.25)
	isKilling = false
end

function KillPlayer()
	if HugTarget ~= nil then
		isKilling = true
		local ops = LocalPlayer.Character:GetPivot()
		local stats = game:GetService("Stats")
		local function getPingSeconds()
			local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			return pingMS / 1000
		end
		local currentPing = getPingSeconds()
		local pingDelay = math.max(currentPing * 3, 0.05) -- Защита от нулевого пинга при старте

		local ops = LocalPlayer.Character:GetPivot()

		local humanoidRootPart = LocalPlayer.Character:WaitForChild("HumanoidRootPart")

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		LocalPlayer.Character:PivotTo(HugTarget.Character:GetPivot())

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		task.wait(pingDelay)

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		GrabEvent:FireServer(
			"tryGrab",
			HugTarget.Character
		)

		task.wait(pingDelay)

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = false
		local ows = LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed
		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 0
		local targetCFrame = CFrame.new(-149, -51, 152) * CFrame.Angles(math.rad(0), math.rad(-90), math.rad(0))
		LocalPlayer.Character:PivotTo(targetCFrame)
		local fixplate = Instance.new("Part", workspace)
		fixplate.Anchored = true
		fixplate.Transparency = 1
		fixplate.Size = Vector3.new(100,1,100)
		fixplate.CFrame = targetCFrame - Vector3.new(0,4,0)
		task.wait(pingDelay)

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		GrabEvent:FireServer(
			"throw"
		)
		LocalPlayer.Character:PivotTo(ops)
		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").AutoRotate = true
		fixplate:Destroy()
		LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = ows
		task.wait(0.5)
		isKilling = false
	end
end

local KillButton = Hug:Button({
	Title = "Kill Target",
	Callback = function()
		if not isKilling then
			KillPlayer()
		end
	end
})

local KillAllButton = Hug:Button({
	Title = "Kill All",
	Callback = function()
		if not isKilling then
			KillAll()
		end
	end
})

-- Esp Loop

while task.wait() do
	if not EspToggle then
		break
	end
	if DB then 
		return 
	end
	DB = true

	pcall(function()
		for i,v in pairs(P:GetChildren()) do
			if v:IsA("Player") then
				if v ~= LP then
					if v.Character then

						local pos = math.floor(((LP.Character:FindFirstChild("HumanoidRootPart")).Position - (v.Character:FindFirstChild("HumanoidRootPart")).Position).magnitude)
						-- Credits to Infinite Yield for this part (pos) ^^^^^^

						if v.Character:FindFirstChild("Totally NOT Esp") == nil and v.Character:FindFirstChild("Icon") == nil and Teamcheck == false then
							--//ESP-Highlight\\--
							local ESP = Instance.new("Highlight", v.Character)

							ESP.Name = "Totally NOT Esp"
							ESP.Adornee = v.Character
							ESP.Archivable = true
							ESP.Enabled = true
							ESP.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							ESP.FillColor = v.TeamColor.Color
							ESP.FillTransparency = 0.5
							ESP.OutlineColor = Color3.fromRGB(255, 255, 255)
							ESP.OutlineTransparency = 0

							--//ESP-Text\\--
							local Icon = Instance.new("BillboardGui", v.Character)
							local ESPText = Instance.new("TextLabel")

							Icon.Name = "Icon"
							Icon.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
							Icon.Active = true
							Icon.AlwaysOnTop = true
							Icon.ExtentsOffset = Vector3.new(0, 1, 0)
							Icon.LightInfluence = 1.000
							Icon.Size = UDim2.new(0, 800, 0, 50)

							ESPText.Name = "ESP Text"
							ESPText.Parent = Icon
							ESPText.BackgroundColor3 = v.TeamColor.Color
							ESPText.BackgroundTransparency = 1.000
							ESPText.Size = UDim2.new(0, 800, 0, 50)
							ESPText.Font = Enum.Font.SciFi
							ESPText.Text = v[PlayerName].." | Distance: "..pos
							ESPText.TextColor3 = v.TeamColor.Color
							ESPText.TextSize = 18.000
							ESPText.TextWrapped = true
						else
							if v.TeamColor ~= LP.TeamColor and v.Character:FindFirstChild("Totally NOT Esp") == nil and v.Character:FindFirstChild("Icon") == nil and Teamcheck == true then
								--//ESP-Highlight\\--
								local ESP = Instance.new("Highlight", v.Character)

								ESP.Name = "Totally NOT Esp"
								ESP.Adornee = v.Character
								ESP.Archivable = true
								ESP.Enabled = true
								ESP.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
								ESP.FillColor = v.TeamColor.Color
								ESP.FillTransparency = 0.5
								ESP.OutlineColor = Color3.fromRGB(255, 255, 255)
								ESP.OutlineTransparency = 0

								--//ESP-Text\\--
								local Icon = Instance.new("BillboardGui", v.Character)
								local ESPText = Instance.new("TextLabel")

								Icon.Name = "Icon"
								Icon.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
								Icon.Active = true
								Icon.AlwaysOnTop = true
								Icon.ExtentsOffset = Vector3.new(0, 1, 0)
								Icon.LightInfluence = 1.000
								Icon.Size = UDim2.new(0, 800, 0, 50)

								ESPText.Name = "ESP Text"
								ESPText.Parent = Icon
								ESPText.BackgroundColor3 = v.TeamColor.Color
								ESPText.BackgroundTransparency = 1.000
								ESPText.Size = UDim2.new(0, 800, 0, 50)
								ESPText.Font = Enum.Font.SciFi
								ESPText.Text = v[PlayerName].." | Distance: "..pos
								ESPText.TextColor3 = v.TeamColor.Color
								ESPText.TextSize = 18.000
								ESPText.TextWrapped = true
							else
								if not v.Character:FindFirstChild("Totally NOT Esp").FillColor == v.TeamColor.Color and not v.Character:FindFirstChild("Icon").TextColor3 == v.TeamColor.Color then
									v.Character:FindFirstChild("Totally NOT Esp").FillColor = v.TeamColor.Color
									v.Character:FindFirstChild("Icon").TextColor3 = v.TeamColor.Color
								else
									if v.Character:FindFirstChild("Totally NOT Esp").Enabled == false and v.Character:FindFirstChild("Icon").Enabled == false then
										v.Character:FindFirstChild("Totally NOT Esp").Enabled = true
										v.Character:FindFirstChild("Icon").Enabled = true
									else
										if v.Character:FindFirstChild("Icon") then
											v.Character:FindFirstChild("Icon")["ESP Text"].Text = v[PlayerName].." | Distance: "..pos
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end)

	wait()

	DB = false
end
