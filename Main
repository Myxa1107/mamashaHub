local function getPlayerNames()
	local names = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			table.insert(names, player.Name)
		end
	end
	if #names == 0 then
		table.insert(names, "Nothing, mamasha is angry")
	end
	return names
end

Hug:Space({ Columns = 1 })

local PlayerSelectDropdown = Hug:Dropdown({
	Title = "Select Target",
	Options = getPlayerNames(), 
	Current = nil, 
	Callback = function(selectedPlayer)
		HugTarget = Players:FindFirstChild(selectedPlayer)
		print(HugTarget)
	end
})

Hug:Space({ Columns = 1 })

local function updateDropdown()
	local currentPlayers = getPlayerNames()
	PlayerSelectDropdown:Refresh(currentPlayers)
end

Players.PlayerAdded:Connect(function(player)
	task.wait(0.5)
	updateDropdown()
end)

Players.PlayerRemoving:Connect(function(player)
	updateDropdown()
end)

task.spawn(function()
	task.wait(0.2)
	updateDropdown()
end)

local GrabButton = Hug:Button({
	Title = "Grab Target",
	Callback = function()
		if HugTarget ~= nil then
			local char = LocalPlayer.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then return end -- Если уже мертв, не начинаем

			local ops = char:GetPivot()

			local stats = game:GetService("Stats")
			local function getPingSeconds()
				local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
				return pingMS / 1000
			end
			local currentPing = getPingSeconds()
			local pingDelay = math.max(currentPing * 3, 0.05)

			local humanoidRootPart = char:WaitForChild("HumanoidRootPart", 2)
			if not humanoidRootPart then return end

			-- Быстрая функция проверки на смерть/респавн
			local function isDead()
				return not humanoid or humanoid.Health <= 0 or LocalPlayer.Character ~= char
			end

			-- Телепорт к цели
			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			if isDead() then return end
			char:PivotTo(HugTarget.Character:GetPivot())

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			task.wait(pingDelay)

			-- Проверка после ожидания пинга
			if isDead() then return end

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			GrabEvent:FireServer(
				"tryGrab",
				HugTarget.Character
			)

			humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

			-- Возврат на исходную позицию (только если персонаж жив)
			if not isDead() then
				char:PivotTo(ops)

				-- Дополнительная проверка на случай, если рут-парт пропал при телепорте назад
				local currentRoot = char:FindFirstChild("HumanoidRootPart")
				if currentRoot then
					currentRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					currentRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				end
			end
		end
	end
})

function KillAll()
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end -- Если уже мертв, не начинаем

	-- Флаг для отслеживания смерти во время работы цикла
	local characterDied = false
	local diedConnection

	-- Подключаем событие смерти
	diedConnection = humanoid.Died:Connect(function()
		characterDied = true
		if diedConnection then diedConnection:Disconnect() end
	end)

	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

	local stats = game:GetService("Stats")
	local function getPingSeconds()
		local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		return pingMS / 1000
	end
	local currentPing = getPingSeconds()
	local pingDelay = math.max(currentPing * 3, 0.05)

	local allplayers = getPlayerNames()
	local ops = char:GetPivot()

	humanoid.AutoRotate = false
	local ows = humanoid.WalkSpeed
	humanoid.WalkSpeed = 0

	local targetCFrame = CFrame.new(-149, -51, 152) * CFrame.Angles(math.rad(0), math.rad(-90), math.rad(0))
	local fixplate = Instance.new("Part", workspace)
	fixplate.Anchored = true
	fixplate.Transparency = 1
	fixplate.Size = Vector3.new(100,1,100)
	fixplate.CFrame = targetCFrame - Vector3.new(0,4,0)

	for _,v in allplayers do
		-- СТРОГАЯ ПРОВЕРКА НА СМЕРТЬ: Если сработал ивент Died или сменился персонаж
		if characterDied or LocalPlayer.Character ~= char or not humanoid or humanoid.Health <= 0 then 
			break 
		end

		local killplr = Players:FindFirstChild(v)
		if not killplr or not killplr.Character then continue end 

		isKilling = true

		local humanoidRootPart = char:FindFirstChild("HumanoidRootPart")
		if not humanoidRootPart then break end -- Без рут-парта продолжать нельзя

		char:PivotTo(killplr.Character:GetPivot())

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		task.wait(pingDelay)

		-- Проверка после ожидания пинга
		if characterDied or humanoid.Health <= 0 then break end

		GrabEvent:FireServer("tryGrab", killplr.Character)

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		char:PivotTo(targetCFrame)

		task.wait(pingDelay)

		-- Проверка после второго ожидания
		if characterDied or humanoid.Health <= 0 then break end

		GrabEvent:FireServer("throw")

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		task.wait(1)
	end

	-- Отключаем событие, чтобы не забивать память
	if diedConnection then diedConnection:Disconnect() end

	-- Убираем платформу в любом случае
	if fixplate then fixplate:Destroy() end

	-- Если персонаж остался жив, возвращаем настройки бега и позиции
	if humanoid and humanoid.Health > 0 and LocalPlayer.Character == char then
		char:PivotTo(ops)
		humanoid.AutoRotate = true
		humanoid.WalkSpeed = ows

		humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, true)
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	task.wait(0.25)
	isKilling = false
end


function KillPlayer()
	if HugTarget ~= nil then
		local char = LocalPlayer.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then return end -- Если уже мертв, выходим

		isKilling = true
		local ops = char:GetPivot()

		local stats = game:GetService("Stats")
		local function getPingSeconds()
			local pingMS = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			return pingMS / 1000
		end
		local currentPing = getPingSeconds()
		local pingDelay = math.max(currentPing * 3, 0.05)

		local humanoidRootPart = char:WaitForChild("HumanoidRootPart", 2)
		if not humanoidRootPart then isKilling = false return end

		-- Переменные для создаваемых объектов, чтобы удалить их при смерти
		local fixplate = nil
		local ows = humanoid.WalkSpeed

		-- Функция-помощник для проверки, жив ли персонаж
		local function isDead()
			return not humanoid or humanoid.Health <= 0 or LocalPlayer.Character ~= char
		end

		-- Шаг 1: Телепорт к цели
		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		if isDead() then isKilling = false return end
		char:PivotTo(HugTarget.Character:GetPivot())

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		task.wait(pingDelay)

		-- Шаг 2: Захват (Grab)
		if isDead() then isKilling = false return end
		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		GrabEvent:FireServer("tryGrab", HugTarget.Character)

		task.wait(pingDelay)

		-- Шаг 3: Подготовка платформы и телепорт на точку сброса
		if isDead() then isKilling = false return end
		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		humanoid.AutoRotate = false
		humanoid.WalkSpeed = 0

		local targetCFrame = CFrame.new(-149.5, -51, 152) * CFrame.Angles(math.rad(0), math.rad(-90), math.rad(0))
		char:PivotTo(targetCFrame)

		fixplate = Instance.new("Part", workspace)
		fixplate.Anchored = true
		fixplate.Transparency = 1
		fixplate.Size = Vector3.new(100,1,100)
		fixplate.CFrame = targetCFrame - Vector3.new(0,4,0)

		task.wait(pingDelay)

		-- Шаг 4: Бросок (Throw)
		if isDead() then 
			if fixplate then fixplate:Destroy() end
			isKilling = false 
			return 
		end

		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		humanoidRootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

		GrabEvent:FireServer("throw")

		-- Возвращаем всё назад, если персонаж выжил
		if not isDead() then
			char:PivotTo(ops)
			humanoid.AutoRotate = true
			humanoid.WalkSpeed = ows
		end

		if fixplate then fixplate:Destroy() end
		task.wait(0.5)
		isKilling = false
	end
end


local KillButton = Hug:Button({
	Title = "Kill Target",
	Callback = function()
		if not isKilling then
			KillPlayer()
		end
	end
})

local KillAllButton = Hug:Button({
	Title = "Kill All",
	Callback = function()
		if not isKilling then
			KillAll()
		end
	end
})
